ENVIRONMENT=production
HF_API_TOKEN=hf_replace_with_server_secret
# Upload the model/adaptor produced in Kaggle to a Hugging Face model repository.
HF_PALIGEMMA2_MODEL=google/paligemma2-3b-pt-224
HF_QWEN25_VL_MODEL=Mwizerwa/meme-qwen2.5-vl-finetuned
HF_INTERNVL25_MODEL=OpenGVLab/InternVL2_5-4B
HF_LLAVA_ONEVISION_MODEL=llava-hf/llava-onevision-qwen2-7b-ov-hf
HF_MINICPM_V_MODEL=openbmb/MiniCPM-V-2_6
HF_API_BASE_URL=https://router.huggingface.co/v1
MODAL_CAPTION_URL=https://your-modal-caption-endpoint.modal.run
MODAL_CAPTION_TIMEOUT_SECONDS=600
CORS_ORIGINS=https://your-frontend-domain.example
MAX_UPLOAD_SIZE_MB=10
HF_TIMEOUT_SECONDS=90
MAX_NEW_TOKENS=64
